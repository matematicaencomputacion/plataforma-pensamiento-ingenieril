# Síntesis de perfil de onboarding (POST /api/learner/profile/synthesize)
# xAI Grok — misma key que evaluación. https://console.x.ai/
GROK_API_KEY=
GROK_MODEL=grok-4.5
# Alias opcional:
# XAI_API_KEY=
