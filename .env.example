# Síntesis de perfil de onboarding (POST /api/learner/profile/synthesize)
# Groq (baja latencia). Obtené la key en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Opcional — override del endpoint OpenAI-compatible
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# mock | groq  (mock = keywords offline, sin llamar a Groq)
LEARNER_PROFILE_LLM=groq

# Auth (HU04): JWT + SQLite de usuarios
JWT_SECRET=dev-only-change-me-ppi-jwt-secret
DATABASE_URL=sqlite://./data/ppi.db
