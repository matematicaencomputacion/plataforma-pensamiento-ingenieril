# Credenciales de aplicación (ADC) para Vertex AI / Gemini.
# Copiá este archivo a `.env` y apuntá al JSON real del service account
# colocado en la raíz del monorepo (el .json NO debe versionarse).
#
# Uso: clasificar el texto del alumno → síntesis de perfil
# (migas de pan / perfil de inicio). Backend: POST /api/learner/profile/synthesize

GOOGLE_APPLICATION_CREDENTIALS=./project-2dc3a0ed-9735-4291-b0b-6c50f24476b4.json
GOOGLE_CLOUD_PROJECT=project-2dc3a0ed-9735-4291-b0b
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro

# mock | gemini  (mock = keywords offline, sin llamar a Google)
LEARNER_PROFILE_LLM=gemini

# vertex | gemini-api | auto
LEARNER_PROFILE_BACKEND=vertex
