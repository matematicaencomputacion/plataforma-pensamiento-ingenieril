# mock | grok  (mock = keywords offline, sin llamar a xAI)
LEARNER_PROFILE_LLM=grok

# Auth (HU04): JWT + SQLite de usuarios
JWT_SECRET=dev-only-change-me-ppi-jwt-secret
DATABASE_URL=sqlite://./data/ppi.db
