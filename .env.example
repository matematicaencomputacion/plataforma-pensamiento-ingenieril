# Síntesis de perfil de onboarding (POST /api/learner/profile/synthesize)
# Preferido local: Cerebras (OpenAI-compat). https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Alternativa: xAI Grok
GROK_API_KEY=
GROK_MODEL=grok-4.5
# Alias opcional:
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# auto | mock | keyword | grok | cerebras
# auto = Cerebras si hay CEREBRAS_API_KEY; si no, Grok; si no, keywords.
LEARNER_PROFILE_LLM=auto

# Auth (HU04): JWT + SQLite de usuarios
JWT_SECRET=dev-only-change-me-ppi-jwt-secret
DATABASE_URL=sqlite://./data/ppi.db

# Correo de recuperación (SMTP genérico). Sin esto, forgot-password NO envía mail.
# APP_PUBLIC_URL=https://ingenieria.wechgat.com.ar
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@tudominio.com
# En prod: PPI_EXPOSE_RESET_TOKEN=0

# Estáticos Trunk (fallback on-disk). NUNCA apuntes a web/ (index fuente con data-trunk).
# En Cloud Run el dist va embebido en el binario; STATIC_DIR=/app/static es respaldo.
# STATIC_DIR=./web/dist

# E2E Playwright (web/e2e) — NUNCA committear passwords reales
# PPI_E2E_EMAIL=tu-usuario@example.com
# PPI_E2E_PASSWORD=
# PPI_E2E_MODE=login
# PPI_E2E_BASE_URL=http://127.0.0.1:3001
# PPI_E2E_HEADED=1
